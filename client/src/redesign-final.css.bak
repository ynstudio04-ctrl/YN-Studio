
/* =========================================================
   YN STUDIO — ADMIN FINAL UI REDESIGN
   Light workspace + dark navigation, matching the approved
   dashboard concept while preserving all existing logic.
   ========================================================= */
:root{
  --a-bg:#f6f7fb;
  --a-card:#fff;
  --a-ink:#171823;
  --a-muted:#7b7d8c;
  --a-line:#e9eaf0;
  --a-purple:#6d35e8;
  --a-purple-2:#8b5cf6;
  --a-soft:#f1ecff;
  --a-green:#18a76d;
  --a-red:#e45766;
  --a-yellow:#e8a21a;
  --a-shadow:0 8px 28px rgba(26,25,48,.055);
}

html,body{background:var(--a-bg)!important;color:var(--a-ink)!important;}
body{font-family:"DM Sans",Inter,system-ui,sans-serif!important;}
.app-shell,.app-layout{background:var(--a-bg)!important;min-height:100vh!important;}

/* Sidebar */
.sidebar{width:248px!important;flex:0 0 248px!important;padding:20px 13px!important;background:linear-gradient(180deg,#111523 0%,#0c101b 100%)!important;border-right:0!important;box-shadow:12px 0 36px rgba(19,22,35,.12)!important;}
.sidebar-logo{margin:0 9px 30px!important;color:#fff!important;font-size:18px!important;}
.sidebar-logo::before{width:40px!important;height:40px!important;border-radius:12px!important;background:linear-gradient(135deg,#9b6cff,#6330df)!important;box-shadow:0 10px 24px rgba(109,53,232,.28)!important;}
.sidebar-section{margin-bottom:20px!important;}
.sidebar-title{color:#686d7e!important;font-size:9px!important;letter-spacing:.16em!important;margin:0 10px 7px!important;}
.sidebar-link{min-height:43px!important;border-radius:11px!important;color:#9ca0b0!important;margin:3px 0!important;}
.sidebar-link:hover{color:#fff!important;background:rgba(255,255,255,.055)!important;transform:none!important;}
.sidebar-link.active{color:#fff!important;background:linear-gradient(90deg,#7139e8,#6432d4)!important;box-shadow:0 8px 18px rgba(79,42,174,.23)!important;}
.sidebar-link svg{width:18px!important;}

/* Top bar */
.main-content{background:var(--a-bg)!important;}
.topbar{height:72px!important;padding:0 28px!important;background:rgba(255,255,255,.94)!important;border-bottom:1px solid var(--a-line)!important;backdrop-filter:blur(14px)!important;}
.search-box{width:min(360px,42vw)!important;height:40px!important;background:#f7f7fa!important;border:1px solid var(--a-line)!important;border-radius:12px!important;color:#8d8f9b!important;}
.search-box input{background:transparent!important;border:0!important;color:var(--a-ink)!important;}
.topbar-icon{width:40px!important;height:40px!important;border:1px solid var(--a-line)!important;background:#fff!important;border-radius:12px!important;color:#5d5f6b!important;}
.user-info strong{color:var(--a-ink)!important;font-size:12px!important;}
.user-info span{color:var(--a-muted)!important;font-size:10px!important;}
.user-avatar{background:var(--a-soft)!important;color:var(--a-purple)!important;border:0!important;}

/* Global page surface */
.page-content,.customers-page,.loans-page,.add-customer-page,.cn-orders-page{padding:28px!important;max-width:1480px!important;margin:0 auto!important;}
.page-heading,.customers-header,.loans-header,.add-customer-header,.cn-page-header{margin-bottom:20px!important;}
.page-heading h1,.customers-header h1,.loans-header h1,.add-customer-title,.cn-page-header h1{font-size:27px!important;letter-spacing:-.045em!important;color:var(--a-ink)!important;margin:3px 0!important;}
.eyebrow,.customers-eyebrow,.loans-eyebrow{color:var(--a-purple)!important;font-size:10px!important;font-weight:800!important;letter-spacing:.15em!important;}
.page-heading p,.customers-subtitle{color:var(--a-muted)!important;}

/* Buttons */
.primary-button,.customers-primary-button,.add-customer-page button[type="submit"],.form-save-button,.loans-confirm-btn,.cn-complete-button,.cn-complete-final-button,.login-button{border:0!important;border-radius:11px!important;background:linear-gradient(135deg,var(--a-purple),#8450ed)!important;color:#fff!important;font-weight:800!important;box-shadow:0 8px 18px rgba(109,53,232,.16)!important;}
.secondary-button,.customers-secondary-button,.form-cancel-button,.loans-cancel-btn,.cn-cancel-button{border:1px solid var(--a-line)!important;border-radius:11px!important;background:#fff!important;color:var(--a-ink)!important;}
button{transition:transform .16s ease,box-shadow .16s ease,background .16s ease!important;}
button:hover{transform:translateY(-1px);}

/* Cards */
.stat-card,.dashboard-v2-panel,.customers-count-card,.customer-floating-card,.customer-form-card,.loans-summary-card,.loans-card,.cn-summary-card,.cn-order-card,.glass-card,.info-card,.admin-card,.order-card,.quote-card,.request-card,.empty-state,.empty-payment,.empty-preview,.coupon-add-section,.coupon-item,.saving-card,.modal-card{background:var(--a-card)!important;border:1px solid var(--a-line)!important;box-shadow:var(--a-shadow)!important;border-radius:18px!important;color:var(--a-ink)!important;}

/* Dashboard */
.stats-grid{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:13px!important;margin-bottom:16px!important;}
.stat-card{padding:17px!important;min-height:130px!important;}
.stat-top{display:flex!important;justify-content:space-between!important;align-items:center!important;}
.stat-icon{width:42px!important;height:42px!important;border-radius:13px!important;background:var(--a-soft)!important;color:var(--a-purple)!important;display:grid!important;place-items:center!important;}
.stat-value{font-size:26px!important;font-weight:800!important;letter-spacing:-.04em!important;color:var(--a-ink)!important;margin-top:15px!important;}
.stat-title{font-size:11px!important;font-weight:700!important;color:#5f6270!important;}
.stat-description{font-size:10px!important;color:var(--a-muted)!important;}
.dashboard-v2-grid{display:grid!important;grid-template-columns:minmax(0,1.65fr) minmax(290px,.8fr)!important;gap:15px!important;align-items:start!important;}
.dashboard-v2-main,.dashboard-v2-side{display:flex!important;flex-direction:column!important;gap:15px!important;min-width:0!important;}
.dashboard-v2-panel{padding:18px!important;}
.dashboard-v2-panel-head h2{font-size:16px!important;color:var(--a-ink)!important;}
.dashboard-v2-kicker{color:var(--a-purple)!important;font-size:9px!important;font-weight:800!important;letter-spacing:.14em!important;}
.dashboard-v2-live{color:var(--a-green)!important;font-size:10px!important;}
.dashboard-v2-live span{background:var(--a-green)!important;box-shadow:0 0 0 4px rgba(24,167,109,.1)!important;}
.dashboard-v2-action{border:1px solid var(--a-line)!important;background:#fff!important;border-radius:14px!important;color:var(--a-ink)!important;}
.dashboard-v2-action:hover{border-color:#d7cdf8!important;background:#faf8ff!important;}
.dashboard-v2-action-icon{background:var(--a-soft)!important;color:var(--a-purple)!important;border-radius:11px!important;}
.dashboard-v2-status-row>div{background:#fafafd!important;border:1px solid var(--a-line)!important;border-radius:13px!important;}
.dashboard-v2-tip{background:#f5f0ff!important;border:1px solid #e1d7ff!important;border-radius:15px!important;}
.dashboard-v2-tip-icon{background:#fff!important;color:var(--a-purple)!important;}

/* Tables and list rows */
table{border-collapse:separate!important;border-spacing:0!important;overflow:hidden!important;border:1px solid var(--a-line)!important;border-radius:16px!important;background:#fff!important;}
th{background:#fafafd!important;color:#777a88!important;font-size:10px!important;text-transform:uppercase!important;letter-spacing:.06em!important;border-bottom:1px solid var(--a-line)!important;}
td{color:var(--a-ink)!important;border-bottom:1px solid #f0f0f4!important;font-size:12px!important;}
tr:last-child td{border-bottom:0!important;}

/* Customers */
.customers-search-card{background:#fff!important;border:1px solid var(--a-line)!important;border-radius:16px!important;box-shadow:none!important;padding:10px!important;}
.customers-search-box{background:#f8f8fb!important;border:1px solid var(--a-line)!important;border-radius:11px!important;}
.customers-count-card{display:flex!important;align-items:center!important;gap:12px!important;padding:15px!important;}
.customers-count-icon{background:var(--a-soft)!important;color:var(--a-purple)!important;border-radius:12px!important;}
.customers-list{display:flex!important;flex-direction:column!important;gap:9px!important;margin-top:12px!important;}
.customer-floating-card{display:grid!important;grid-template-columns:auto 1fr auto auto!important;align-items:center!important;gap:13px!important;padding:13px 15px!important;}
.customer-avatar,.loans-avatar,.avatar{background:#eee9ff!important;color:var(--a-purple)!important;border:0!important;}
.customer-name{color:var(--a-ink)!important;font-weight:800!important;}
.customer-code,.customer-type{color:var(--a-muted)!important;}
.customer-arrow{color:#aaaab4!important;}

/* Forms */
.customer-form-card{overflow:hidden!important;}
.customer-form-card-header{padding:16px 18px!important;border-bottom:1px solid var(--a-line)!important;background:#fbfbfd!important;}
.section-number{background:var(--a-soft)!important;color:var(--a-purple)!important;border-radius:10px!important;}
.customer-form-body{padding:18px!important;}
.form-field label,.field-block label,.form-group label{color:#5f6270!important;font-size:11px!important;font-weight:800!important;}
.input-with-icon,.textarea-with-icon,.input-wrapper,.field-with-icon{border:1px solid var(--a-line)!important;background:#fff!important;border-radius:12px!important;}
.input-with-icon input,.textarea-with-icon textarea,.input-wrapper input{background:transparent!important;color:var(--a-ink)!important;border:0!important;}
.customer-type-grid{gap:10px!important;}
.customer-type-radio{border:1px solid var(--a-line)!important;background:#fff!important;border-radius:14px!important;}
.customer-type-radio.active,.customer-type-radio:has(input:checked){border-color:#cfc0f7!important;background:#f7f3ff!important;}

/* Orders */
.orders-page{padding:28px!important;}
.orders-page .page-heading{margin-bottom:18px!important;}
.order-card,.request-card{padding:15px!important;}
.order-card:hover,.request-card:hover,.customer-floating-card:hover,.loans-card:hover{box-shadow:0 12px 30px rgba(26,25,48,.09)!important;}
.order-actions button,.approve-button,.decline-button,.order-cancel-button{border-radius:10px!important;}
.approve-button{background:#e9f8f1!important;color:var(--a-green)!important;border:1px solid #ccecdf!important;}
.decline-button,.danger-button{background:#fff0f2!important;color:var(--a-red)!important;border:1px solid #f4cbd1!important;}

/* Finance / loans */
.loans-summary{display:grid!important;grid-template-columns:repeat(4,1fr)!important;gap:12px!important;margin-bottom:15px!important;}
.loans-summary-card{padding:15px!important;}
.loans-summary-icon{width:40px!important;height:40px!important;border-radius:12px!important;background:var(--a-soft)!important;color:var(--a-purple)!important;}
.loans-card{padding:16px!important;}
.loans-values{display:grid!important;grid-template-columns:repeat(3,1fr)!important;gap:9px!important;}
.loans-values>div{background:#fafafd!important;border:1px solid var(--a-line)!important;border-radius:12px!important;padding:10px!important;}
.loans-progress{background:#ecebf1!important;height:7px!important;border-radius:20px!important;}
.loans-progress-bar{background:linear-gradient(90deg,var(--a-purple),#9c73f3)!important;border-radius:20px!important;}
.loans-actions{display:flex!important;gap:8px!important;}
.loans-search{background:#fff!important;border:1px solid var(--a-line)!important;border-radius:13px!important;}

/* China/Vietnam import pages */
.cn-summary-grid{display:grid!important;grid-template-columns:repeat(4,1fr)!important;gap:12px!important;margin-bottom:15px!important;}
.cn-summary-card{padding:15px!important;}
.cn-summary-icon,.cn-order-icon,.cn-info-icon{background:var(--a-soft)!important;color:var(--a-purple)!important;border-radius:12px!important;}
.cn-order-card{padding:17px!important;}
.cn-progress-track{height:8px!important;background:#ecebf1!important;border-radius:20px!important;}
.cn-progress-fill{background:linear-gradient(90deg,var(--a-purple),#9d72f5)!important;border-radius:20px!important;}
.cn-info-grid,.cn-order-info-grid{gap:9px!important;}
.cn-info-box{background:#fafafd!important;border:1px solid var(--a-line)!important;border-radius:13px!important;}
.cn-status-control{border:1px solid var(--a-line)!important;border-radius:11px!important;background:#fff!important;}

/* Customer profile / settings */
.profile-hero{background:#fff!important;border:1px solid var(--a-line)!important;box-shadow:var(--a-shadow)!important;border-radius:20px!important;padding:18px!important;}
.customer-stats{gap:12px!important;}
.customer-stats .glass-card{padding:16px!important;}
.edit-panel,.info-card,.wallet-history{background:#fff!important;border:1px solid var(--a-line)!important;border-radius:18px!important;box-shadow:var(--a-shadow)!important;}
.customer-wallet-action{border:1px solid var(--a-line)!important;border-radius:12px!important;background:#fff!important;}

/* Login */
.login-page{min-height:100vh!important;background:linear-gradient(135deg,#f7f4ff,#f6f7fb)!important;display:grid!important;place-items:center!important;padding:24px!important;}
.login-card{width:min(430px,100%)!important;background:#fff!important;border:1px solid var(--a-line)!important;border-radius:24px!important;box-shadow:0 20px 60px rgba(35,30,65,.1)!important;padding:30px!important;}
.brand-mark{width:58px!important;height:58px!important;border-radius:17px!important;background:linear-gradient(135deg,#9a6cff,#6330df)!important;box-shadow:0 12px 25px rgba(109,53,232,.22)!important;}
.login-heading h1{color:var(--a-ink)!important;font-size:28px!important;letter-spacing:-.045em!important;}
.login-heading p,.login-footer{color:var(--a-muted)!important;}
.login-card .input-wrapper{min-height:50px!important;border:1px solid var(--a-line)!important;border-radius:13px!important;background:#fff!important;}
.login-card .input-wrapper input{color:var(--a-ink)!important;}

/* Modals */
.modal-overlay,.cn-modal-overlay,.loans-modal-overlay,.cn-proof-modal,.receipt-preview-overlay{background:rgba(18,20,30,.38)!important;backdrop-filter:blur(6px)!important;}
.modal-card,.modal-head,.loans-payment-modal,.cn-proof-preview{background:#fff!important;border:1px solid var(--a-line)!important;border-radius:20px!important;box-shadow:0 25px 70px rgba(22,24,36,.2)!important;}
.modal-header,.modal-footer{border-color:var(--a-line)!important;}
.modal-primary{background:var(--a-purple)!important;color:#fff!important;border:0!important;border-radius:11px!important;}
.modal-secondary{background:#fff!important;color:var(--a-ink)!important;border:1px solid var(--a-line)!important;border-radius:11px!important;}

/* Responsive */
@media (max-width:1100px){
  .sidebar{width:218px!important;flex-basis:218px!important;}
  .stats-grid{grid-template-columns:repeat(2,1fr)!important;}
  .loans-summary,.cn-summary-grid{grid-template-columns:repeat(2,1fr)!important;}
  .dashboard-v2-grid{grid-template-columns:1fr!important;}
}
@media (max-width:760px){
  .sidebar{width:72px!important;flex-basis:72px!important;padding:15px 8px!important;}
  .sidebar-logo{font-size:0!important;justify-content:center!important;margin:0 0 20px!important;}
  .sidebar-link span,.sidebar-title{display:none!important;}
  .sidebar-link{justify-content:center!important;padding:0!important;}
  .topbar{padding:0 14px!important;}
  .search-box{display:none!important;}
  .page-content,.customers-page,.loans-page,.add-customer-page,.cn-orders-page,.orders-page{padding:18px!important;}
}
@media (max-width:560px){
  .stats-grid,.loans-summary,.cn-summary-grid{grid-template-columns:1fr!important;}
}

/* =========================================================
   YN STUDIO V4 — COMPLETE ADMIN WORKSPACE REDESIGN
   Visual-only system: preserves existing routes and data logic.
========================================================= */
:root{
  --v4-bg:#f5f6fa;
  --v4-surface:#ffffff;
  --v4-surface-2:#faf9ff;
  --v4-ink:#151522;
  --v4-muted:#777487;
  --v4-line:#e9e8ef;
  --v4-brand:#6d35e8;
  --v4-brand-2:#8b5cf6;
  --v4-brand-soft:#f0eaff;
  --v4-success:#15966a;
  --v4-danger:#df5365;
  --v4-warning:#c98a18;
  --v4-shadow:0 14px 40px rgba(36,27,70,.07);
}
html,body,#root{background:var(--v4-bg)!important;color:var(--v4-ink)!important;}
body{font-family:Inter,"DM Sans",system-ui,sans-serif!important;}
.app-shell{min-height:100vh!important;background:var(--v4-bg)!important;}
.sidebar{
  width:264px!important;flex:0 0 264px!important;box-sizing:border-box!important;
  padding:18px 14px!important;background:#141321!important;border:0!important;
  box-shadow:18px 0 45px rgba(25,20,45,.10)!important;
}
.sidebar-logo{
  height:56px!important;margin:0 6px 20px!important;padding:0 12px!important;
  display:flex!important;align-items:center!important;gap:11px!important;
  color:#fff!important;font-size:18px!important;font-weight:800!important;letter-spacing:-.03em!important;
}
.sidebar-logo::before{
  content:"YN"!important;width:40px!important;height:40px!important;display:grid!important;place-items:center!important;
  border-radius:13px!important;background:linear-gradient(135deg,#9a75ff,#6330df)!important;
  color:#fff!important;font-size:13px!important;font-weight:900!important;box-shadow:0 10px 24px rgba(109,53,232,.28)!important;
}
.sidebar nav{display:flex!important;flex-direction:column!important;gap:2px!important;}
.sidebar-section{margin:10px 0 16px!important;}
.sidebar-title{margin:0 10px 7px!important;color:#777387!important;font-size:9px!important;font-weight:800!important;letter-spacing:.18em!important;}
.sidebar-link{
  min-height:44px!important;padding:0 12px!important;border-radius:13px!important;
  color:#aaa6b8!important;text-decoration:none!important;display:flex!important;align-items:center!important;gap:11px!important;
  font-size:13px!important;font-weight:650!important;transition:.18s ease!important;
}
.sidebar-link:hover{background:#211e31!important;color:#fff!important;}
.sidebar-link.active{
  color:#fff!important;background:linear-gradient(90deg,rgba(125,83,237,.26),rgba(125,83,237,.08))!important;
  box-shadow:inset 3px 0 0 #8f6cff!important;
}
.main-content{min-width:0!important;background:var(--v4-bg)!important;}
.topbar{
  height:76px!important;padding:0 28px!important;background:rgba(245,246,250,.92)!important;
  border-bottom:1px solid var(--v4-line)!important;backdrop-filter:blur(14px)!important;
}
.main-content>div:not(.topbar),.page-container,.dashboard-page,.customers-page,.services-page,.orders-page,.receipts-page,.wallet-page,.payments-page,.loans-page,.savings-page,.settings-page,.china-orders-page,.vietnam-orders-page{
  color:var(--v4-ink)!important;
}
.page-header,.customers-header,.cn-page-header,.dashboard-header,.orders-header,.services-header,.receipts-header,.wallet-header,.payments-header,.loans-header,.settings-header,.savings-header{
  border:0!important;background:transparent!important;box-shadow:none!important;border-radius:0!important;
  padding:10px 0 18px!important;
}
.page-header h1,.customers-header h1,.dashboard-header h1,.orders-header h1,.services-header h1,.receipts-header h1,.wallet-header h1,.payments-header h1,.loans-header h1,.settings-header h1,.savings-header h1{
  font-size:28px!important;letter-spacing:-.045em!important;font-weight:820!important;color:var(--v4-ink)!important;
}
.admin-card,.dashboard-v2-panel,.customer-form-card,.customer-floating-card,.customers-count-card,.customers-empty-card,.cn-summary-card,.cn-order-card,.payment-card,.wallet-card,.loan-card,.service-card,.order-card,.receipt-card,.settings-card,.savings-card{
  border:1px solid var(--v4-line)!important;background:var(--v4-surface)!important;border-radius:20px!important;
  box-shadow:var(--v4-shadow)!important;
}
button{font-family:inherit!important;}
button,.approve-button,.edit-button,.customers-primary-button,.customers-secondary-button,.add-button,.primary-button,.save-button{
  border-radius:12px!important;font-weight:700!important;
}
input,textarea,select,.custom-select,.form-field input,.form-field textarea{
  border:1px solid var(--v4-line)!important;background:#fff!important;color:var(--v4-ink)!important;
  border-radius:13px!important;box-shadow:none!important;min-height:44px!important;
}
input:focus,textarea:focus,select:focus{border-color:#9c82ed!important;box-shadow:0 0 0 4px rgba(109,53,232,.09)!important;outline:none!important;}
table{border-collapse:separate!important;border-spacing:0 7px!important;}
thead th{border:0!important;color:#888493!important;font-size:10px!important;text-transform:uppercase!important;letter-spacing:.1em!important;}
tbody tr{background:#fff!important;box-shadow:0 3px 16px rgba(31,25,55,.045)!important;}
tbody td{border-top:1px solid var(--v4-line)!important;border-bottom:1px solid var(--v4-line)!important;background:#fff!important;}
tbody td:first-child{border-left:1px solid var(--v4-line)!important;border-radius:14px 0 0 14px!important;}
tbody td:last-child{border-right:1px solid var(--v4-line)!important;border-radius:0 14px 14px 0!important;}
.empty-state,.dashboard-empty,.cn-empty,.empty-payment{border:1px dashed #d9d6e4!important;background:#fbfaff!important;border-radius:18px!important;}
.status-badge,.badge,.status-pill{border-radius:999px!important;font-weight:750!important;}
.error-banner,.error-message{border-radius:14px!important;}
@media(max-width:900px){
  .sidebar{width:78px!important;flex-basis:78px!important;padding:14px 8px!important;}
  .sidebar-logo{justify-content:center!important;padding:0!important;font-size:0!important;}
  .sidebar-logo::before{margin:0!important;}
  .sidebar-title,.sidebar-link span{display:none!important;}
  .sidebar-link{justify-content:center!important;padding:0!important;}
  .topbar{padding:0 16px!important;}
}

/* =========================================================
   YN STUDIO — FINAL ADMIN PURPLE / BLACK THEME
   Replaces the old white boxed admin surfaces.
========================================================= */
:root {
  --admin-bg: #07050d;
  --admin-bg-2: #0d0915;
  --admin-surface: #100b19;
  --admin-surface-2: #151020;
  --admin-surface-3: #1b1428;
  --admin-line: rgba(167, 139, 250, .16);
  --admin-line-strong: rgba(139, 92, 246, .38);
  --admin-text: #f7f3ff;
  --admin-muted: #a79bb8;
  --admin-purple: #8b5cf6;
  --admin-purple-2: #6d28d9;
  --admin-purple-soft: rgba(139, 92, 246, .12);
  --admin-shadow: 0 18px 50px rgba(0,0,0,.28);
}

html, body, #root,
.app-shell,
.main-content {
  background: var(--admin-bg) !important;
  color: var(--admin-text) !important;
}

body {
  background:
    radial-gradient(circle at 75% -10%, rgba(109,40,217,.20), transparent 32%),
    radial-gradient(circle at 10% 100%, rgba(76,29,149,.13), transparent 30%),
    var(--admin-bg) !important;
}

.sidebar {
  background: linear-gradient(180deg, #08060d 0%, #0d0914 100%) !important;
  border-right: 1px solid var(--admin-line) !important;
  box-shadow: 16px 0 50px rgba(0,0,0,.28) !important;
}

.sidebar-logo::before {
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 48%, #4c1d95 100%) !important;
  box-shadow: 0 10px 30px rgba(124,58,237,.35) !important;
}

.sidebar-title { color: #70657f !important; }
.sidebar-link { color: #9d91ad !important; }
.sidebar-link:hover {
  color: #fff !important;
  background: rgba(139,92,246,.10) !important;
}
.sidebar-link.active {
  color: #fff !important;
  background: linear-gradient(90deg, rgba(124,58,237,.30), rgba(124,58,237,.08)) !important;
  box-shadow: inset 3px 0 0 #a78bfa, 0 8px 25px rgba(76,29,149,.12) !important;
}

.topbar {
  background: rgba(7,5,13,.88) !important;
  border-bottom: 1px solid var(--admin-line) !important;
  backdrop-filter: blur(20px) !important;
}

.search-box,
.topbar-icon,
.user-info,
.notification-button,
.header-action,
.profile-menu {
  background: var(--admin-surface) !important;
  border-color: var(--admin-line) !important;
  color: var(--admin-text) !important;
}

.search-box input,
.topbar input {
  color: var(--admin-text) !important;
}
.search-box input::placeholder { color: #665b74 !important; }
.topbar-icon:hover { background: var(--admin-surface-2) !important; color: #c4b5fd !important; }

.user-info strong { color: #fff !important; }
.user-info span { color: var(--admin-muted) !important; }
.user-avatar {
  background: linear-gradient(135deg, #9b6cff, #5b21b6) !important;
  color: #fff !important;
  box-shadow: 0 8px 22px rgba(109,40,217,.25) !important;
}

/* All common admin cards/panels */
.admin-card,
.dashboard-v2-panel,
.customer-form-card,
.customer-floating-card,
.customers-count-card,
.customers-empty-card,
.customers-search-card,
.cn-summary-card,
.cn-order-card,
.payment-card,
.wallet-card,
.loan-card,
.service-card,
.order-card,
.receipt-card,
.settings-card,
.savings-card,
.profile-hero,
.edit-panel,
.info-card,
.wallet-history,
.customer-wallet-action,
.dashboard-card,
.stat-card,
.summary-card,
.list-card,
.content-card {
  background: linear-gradient(145deg, var(--admin-surface-2), var(--admin-surface)) !important;
  color: var(--admin-text) !important;
  border: 1px solid var(--admin-line) !important;
  box-shadow: var(--admin-shadow) !important;
}

/* Remove the old white boxed look from generic containers. */
.page-content,
.customers-page,
.services-page,
.orders-page,
.receipts-page,
.wallet-page,
.payments-page,
.loans-page,
.savings-page,
.settings-page,
.cn-orders-page,
.vietnam-orders-page,
.dashboard-page,
.add-customer-page {
  color: var(--admin-text) !important;
}

.page-header h1,
.customers-header h1,
.dashboard-header h1,
.orders-header h1,
.services-header h1,
.receipts-header h1,
.wallet-header h1,
.payments-header h1,
.loans-header h1,
.settings-header h1,
.savings-header h1,
.cn-page-header h1 {
  color: #fff !important;
}

.page-header p,
.customers-header p,
.dashboard-header p,
.orders-header p,
.services-header p,
.receipts-header p,
.wallet-header p,
.payments-header p,
.loans-header p,
.settings-header p,
.savings-header p,
.cn-page-header p,
.muted,
.text-muted {
  color: var(--admin-muted) !important;
}

/* Inputs, selects and textareas are dark too. */
input,
textarea,
select,
.custom-select,
.form-field input,
.form-field textarea,
.input-with-icon,
.textarea-with-icon,
.input-wrapper,
.field-with-icon,
.customers-search-card input,
.loans-search,
.cn-status-control {
  background: #0b0811 !important;
  color: #f8f5ff !important;
  border: 1px solid var(--admin-line) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.02) !important;
}
input::placeholder,
textarea::placeholder { color: #62576e !important; }
input:focus,
textarea:focus,
select:focus {
  border-color: var(--admin-line-strong) !important;
  box-shadow: 0 0 0 4px rgba(139,92,246,.10) !important;
}

/* Tables: no white rows. */
table,
thead,
tbody,
tbody tr,
tbody td {
  background: transparent !important;
  color: var(--admin-text) !important;
}
table {
  border-color: var(--admin-line) !important;
  background: var(--admin-surface) !important;
}
thead th {
  color: #887b99 !important;
  background: #0c0912 !important;
  border-color: var(--admin-line) !important;
}
tbody tr {
  background: #100b19 !important;
  box-shadow: 0 4px 18px rgba(0,0,0,.18) !important;
}
tbody tr:hover { background: #171022 !important; }
tbody td {
  background: transparent !important;
  border-color: var(--admin-line) !important;
}

/* Buttons */
button,
.primary-button,
.btn-primary,
.approve-button,
.edit-button,
.customers-primary-button,
.add-button,
.form-save-button,
.save-button,
.loans-confirm-btn,
.cn-complete-button,
.cn-complete-final-button,
.modal-primary,
.login-button {
  color: #fff !important;
  background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%) !important;
  border-color: transparent !important;
  box-shadow: 0 10px 25px rgba(109,40,217,.22) !important;
}
button:hover,
.primary-button:hover,
.btn-primary:hover,
.customers-primary-button:hover,
.add-button:hover,
.save-button:hover {
  filter: brightness(1.08) !important;
}

.secondary-button,
.customers-secondary-button,
.form-cancel-button,
.loans-cancel-btn,
.cn-cancel-button,
.modal-secondary {
  color: #ddd5e9 !important;
  background: #171121 !important;
  border: 1px solid var(--admin-line) !important;
}

/* Empty states and notices */
.empty-state,
.dashboard-empty,
.cn-empty,
.empty-payment {
  background: #0d0915 !important;
  color: var(--admin-muted) !important;
  border-color: var(--admin-line-strong) !important;
}

/* Modals */
.modal-card,
.modal-head,
.loans-payment-modal,
.cn-proof-preview,
.modal-content,
.modal-body,
.modal-footer {
  background: #100b19 !important;
  color: var(--admin-text) !important;
  border-color: var(--admin-line) !important;
}

/* Login stays consistent with the admin brand. */
.login-card {
  background: linear-gradient(145deg, #151020, #0d0915) !important;
  color: #fff !important;
  border: 1px solid var(--admin-line) !important;
  box-shadow: 0 25px 80px rgba(0,0,0,.45) !important;
}
.login-card .input-wrapper { background: #0b0811 !important; }

/* Purple accents for links, icons and active controls. */
.dashboard-v2-action,
.customer-type-radio,
.dashboard-v2-action-icon,
.dashboard-v2-tip-icon,
.customer-wallet-action {
  background: #171021 !important;
  color: #d8c8ff !important;
  border-color: var(--admin-line) !important;
}
.dashboard-v2-action:hover,
.customer-type-radio:hover {
  border-color: var(--admin-line-strong) !important;
  background: #1d142c !important;
}

/* Keep the floating JARVIS orb purple/black — never a white circle. */
.jarvis-orb {
  background: radial-gradient(circle at 35% 30%, #c4b5fd 0%, #8b5cf6 25%, #6d28d9 55%, #160025 100%) !important;
}
.jarvis-overlay { background: rgba(0,0,0,.62) !important; }

@media (max-width: 760px) {
  .topbar { background: rgba(7,5,13,.94) !important; }
}
