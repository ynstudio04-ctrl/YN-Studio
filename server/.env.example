SUPABASE_DATABASE_URL=
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
CLIENT_URL=http://localhost:5173
CUSTOMER_URL=http://localhost:5174
CORS_ORIGINS=

# Free JARVIS option (Google AI Studio / Gemini Developer API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite


# Telegram bank-notification auto verification
# Keep the bot token server-side only. Do not put it in client/customer .env files.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public API origin, e.g. https://your-api.onrender.com
TELEGRAM_WEBHOOK_URL=
# Optional extra secret sent by Telegram to the webhook
TELEGRAM_WEBHOOK_SECRET=
# Currency printed by the bank notification. The app amount must use the same currency.
TELEGRAM_PAYMENT_CURRENCIES=KHR,USD
# A payment must have exactly one matching pending request inside this window.
TELEGRAM_AUTO_APPROVE_WINDOW_MINUTES=20
